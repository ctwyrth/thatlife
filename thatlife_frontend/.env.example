# Google OAuth Web Client ID (public; used by @react-oauth/google)
# Create at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_API_TOKEN=your-google-oauth-client-id.apps.googleusercontent.com

# Sanity project ID and API token with write access for posts/likes/comments
# Create at https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_TOKEN=your-sanity-api-token
